+/* The left expansion is ((radius + 4) << level) - 4. Subtracting
+ * it from the aligned output width gives a right expansion bounded by
+ * ((radius + 5) << level) - 5, attained for an aligned (w + offset).
+ * The same bound applies independently to height. */
+int ass_gaussian_blur_padding(double r2)
+{
+    BlurMethod blur;
+    find_best_method(&blur, r2);
+    return ((blur.radius + 5) << blur.level) - 5;
+}
+
+/* Match the aligned temporary dimensions used below before allocating them. */
+bool ass_gaussian_blur_budget(const BitmapEngine *engine, int w, int h,
+                              double r2, size_t max_pixels)
+{
+    BlurMethod blur;
+    find_best_method(&blur, r2);
+    int offset = ((2 * blur.radius + 9) << blur.level) - 5;
+    uint64_t end_w = (((uint64_t) w + offset) & ~((1ULL << blur.level) - 1)) - 4;
+    uint64_t end_h = (((uint64_t) h + offset) & ~((1ULL << blur.level) - 1)) - 4;
+    const unsigned stripe_width = 1 << (engine->align_order - 1);
+    uint64_t size = ((end_w + stripe_width - 1) & ~(uint64_t)(stripe_width - 1)) * end_h;
+    return size <= max_pixels && size <= INT_MAX / 4;
+}

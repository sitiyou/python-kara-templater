+
+/* Use the same radius quantization and kernel as native ASS glyph blur,
+ * but accept coverage already partitioned by material. */
+int ass_blur_coverage(ASS_Renderer *priv, const unsigned char *data, int w, int h,
+                      double radius, size_t max_pixels, ASS_Coverage *out)
+{
+    if (!priv || !data || !out || w <= 0 || h <= 0 || !isfinite(radius) ||
+        radius < 0 || radius > BLUR_MAX_RADIUS)
+        return -1;
+    const BitmapEngine *engine = &priv->engine;
+    const unsigned align = 1 << engine->align_order;
+    uint64_t input_size = (((uint64_t) w + align - 1) & ~(uint64_t)(align - 1)) * h;
+    if (input_size > max_pixels || input_size > INT_MAX - align)
+        return -2;
+    int32_t shadow_mask;
+    double r2 = restore_blur(quantize_blur(radius * (2 / sqrt(log(256))), &shadow_mask));
+    if (r2 > 0.001 && !ass_gaussian_blur_budget(engine, w, h, r2, max_pixels))
+        return -2;
+    Bitmap bitmap = {0};
+    if (!ass_alloc_bitmap(engine, &bitmap, w, h, true))
+        return -3;
+    for (int y = 0; y < h; y++)
+        memcpy(bitmap.buffer + y * bitmap.stride, data + (size_t) y * w, w);
+    if (r2 > 0.001 && !ass_gaussian_blur(engine, &bitmap, r2, r2)) {
+        ass_free_bitmap(&bitmap);
+        return -3;
+    }
+    *out = (ASS_Coverage) {bitmap.left, bitmap.top, bitmap.w, bitmap.h,
+                          bitmap.stride, bitmap.buffer};
+    return 0;
+}
+
+void ass_free_coverage(ASS_Coverage *coverage)
+{
+    if (!coverage) return;
+    Bitmap bitmap = {.buffer = coverage->buffer};
+    ass_free_bitmap(&bitmap);
+    memset(coverage, 0, sizeof(*coverage));

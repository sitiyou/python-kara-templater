---
import {Icon} from "@astrojs/starlight/components";
import SiteDropdown from "./SiteDropdown.astro";

const themes = [
	{value: "dark", icon: "moon", label: Astro.locals.t("themeSelect.dark")},
	{value: "light", icon: "sun", label: Astro.locals.t("themeSelect.light")},
	{value: "auto", icon: "laptop", label: Astro.locals.t("themeSelect.auto")},
] as const;
---

<div data-theme-dropdown>
	<SiteDropdown label={Astro.locals.t("themeSelect.accessibleLabel")} current={themes[0].label} value="dark" align="end">
		<span slot="icon" class="site-dropdown-icon" aria-hidden="true">
			{themes.map(({icon, value}) => <Icon name={icon} class={`theme-icon-${value}`} />)}
		</span>
		{themes.map(({icon, label, value}) => (
			<button type="button" class="site-dropdown-option" data-option={value} aria-pressed={value === "dark"}>
				<Icon name={icon} class="site-dropdown-icon" />
				<span class="site-dropdown-name">{label}</span>
			</button>
		))}
	</SiteDropdown>
</div>

<style>
	[data-theme-dropdown] :global(kara-dropdown:not([data-value="dark"]) .theme-icon-dark),
	[data-theme-dropdown] :global(kara-dropdown:not([data-value="light"]) .theme-icon-light),
	[data-theme-dropdown] :global(kara-dropdown:not([data-value="auto"]) .theme-icon-auto) {
		display: none;
	}
</style>

<script>
	type Theme = "auto" | "dark" | "light";
	const storageKey = "starlight-theme";
	const systemTheme = matchMedia("(prefers-color-scheme: light)");

	const parseTheme = (theme: unknown): Theme =>
		theme === "auto" || theme === "dark" || theme === "light" ? theme : "dark";

	function loadTheme(): Theme {
		return parseTheme(localStorage.getItem(storageKey));
	}

	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme === "auto"
			? systemTheme.matches ? "light" : "dark"
			: theme;
		for (const dropdown of document.querySelectorAll<HTMLElement>("[data-theme-dropdown] kara-dropdown")) {
			dropdown.dataset.value = theme;
		}
	}

	document.addEventListener("click", (event) => {
		const option = (event.target as Element).closest<HTMLElement>("[data-theme-dropdown] [data-option]");
		if (!option) return;
		const theme = parseTheme(option.dataset.option);
		localStorage.setItem(storageKey, theme);
		applyTheme(theme);
	});
	systemTheme.addEventListener("change", () => {
		if (loadTheme() === "auto") applyTheme("auto");
	});
	window.addEventListener("pageshow", () => applyTheme(loadTheme()));
	window.addEventListener("storage", (event) => {
		if (event.key === storageKey || event.key === null) applyTheme(loadTheme());
	});
	applyTheme(loadTheme());
</script>

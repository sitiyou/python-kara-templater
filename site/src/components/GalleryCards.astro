---
import {demos, localizeDemo, previewUrl, url} from "../lib/gallery";
import {getUi, type Locale} from "../lib/i18n";

interface Props {
	locale?: Locale;
}

const {locale = "en"} = Astro.props;
const ui = getUi(locale);
const localized = demos.map((demo) => localizeDemo(demo, locale));

const categoryMap = new Map<string, {label: string; count: number}>();
for (const demo of localized) {
	const existing = categoryMap.get(demo.rawCategory);
	if (existing) existing.count += 1;
	else categoryMap.set(demo.rawCategory, {label: demo.category, count: 1});
}
const categories = [
	{key: "All", label: ui.gallery.allFilter, count: localized.length},
	...[...categoryMap.entries()].map(([key, info]) => ({key, ...info})),
];
---

<kara-gallery data-error-text={ui.gallery.errorStatus}>
	<div class="gallery-filters" role="group" aria-label={ui.gallery.filterAria} hidden>
		{categories.map((category) => (
			<button
				type="button"
				aria-pressed={category.key === "All"}
				data-filter={category.key}
			>
				<span>{category.label}</span>
				<span class="filter-count">{category.count}</span>
			</button>
		))}
	</div>
	<p class="gallery-status" role="status" hidden></p>
	<div class="gallery-grid">
		{localized.map((demo) => (
			<article data-category={demo.rawCategory}>
				<a
					class="gallery-card"
					href={url(`gallery/${demo.id}/`, locale)}
					style={`--sample-accent:${demo.accent}`}
				>
					<div
						class="gallery-still"
						data-resources={previewUrl(demo)}
						data-still={demo.still}
						data-width={demo.width}
						data-height={demo.height}
					>
						<img alt="" hidden />
						{demo.hasControls && (
							<span
								class="gallery-badge"
								title={ui.gallery.interactiveBadge}
								aria-label={ui.gallery.interactiveBadge}
							>
								<svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
									<path d="M2.5 4.5h11M2.5 11.5h11" />
									<circle cx="6" cy="4.5" r="1.7" fill="#0a0b10" />
									<circle cx="10.5" cy="11.5" r="1.7" fill="#0a0b10" />
								</svg>
							</span>
						)}
					</div>
					<div class="gallery-caption">
						<span class="gallery-category">{demo.category}</span>
						<h2>{demo.title}</h2>
						<p>{demo.summary}</p>
					</div>
				</a>
			</article>
		))}
	</div>
</kara-gallery>
<script>
	import "../lib/gallery-cards";
</script>
